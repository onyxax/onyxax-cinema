# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file — it is ignored by git.

# Supabase (https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# TMDB (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your-tmdb-api-key

# Cloudinary (https://cloudinary.com) — used for avatar uploads
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-api-key

# Discord Rich Presence (https://discord.com/developers/applications)
VITE_DISCORD_CLIENT_ID=your-discord-client-id

# GitHub repository hosting the NSIS installer releases.
# Used by the in-app updater: github.com/<owner>/<repo>/releases
VITE_UPDATE_GITHUB_REPO=your-name/your-repo
