{
  "name": "onyxax-cinema",
  "productName": "Onyxax Cinema",
  "version": "1.2.9",
  "description": "A cinematic streaming desktop application \u2014 movies, TV series and anime in one elegant experience.",
  "private": true,
  "license": "MIT",
  "author": "Onyxax",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:i18n": "node scripts/check-i18n.js",
    "preview": "vite preview",
    "electron:dev": "vite",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.onyxax.cinema",
    "productName": "Onyxax Cinema",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/AppIcon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Onyxax Cinema",
      "installerIcon": "public/AppIcon.ico",
      "uninstallerIcon": "public/AppIcon.ico",
      "artifactName": "OnyxaxCinemaSetup${version}.${ext}"
    },
    "asar": true,
    "compression": "maximum",
    "buildDependenciesFromSource": false,
    "linux": {
      "target": "AppImage",
      "icon": "public/AppIcon512.png",
      "category": "AudioVideo"
    },
    "icon": "public/AppIcon512.png"
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.4",
    "@cloudinary/url-gen": "^1.22.0",
    "@supabase/supabase-js": "^2.105.3",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.16.0",
    "discord-rpc": "^4.0.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.14.0",
    "peerjs": "^1.5.5",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.14.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "^10.0.1",
    "@types/discord-rpc": "^4.0.10",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.10.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "path-browserify": "^1.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}